# ===========================================================================
# Salin ke .env di ROOT repository:  cp .env.example .env
# Dipakai oleh docker-compose.yml saja. Rahasia aplikasi tetap di Backend/.env
# ===========================================================================

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=db_jasa_angkut
POSTGRES_PORT=5432

# --- Seed ------------------------------------------------------------------
# true = jalankan prisma db seed saat container migrate pertama kali jalan.
# Seed hanya membuat SUPER_ADMIN jika belum ada (idempoten).
SEED_ON_START=true
# Opsional, diisi di Backend/.env juga boleh:
# SEED_ADMIN_NAME=Super Admin
# SEED_ADMIN_EMAIL=admin@jasa-antar.test
# SEED_ADMIN_PASSWORD=ganti_password_admin

# --- CORS & URL aplikasi (sesuaikan dengan domain produksi Anda) -----------
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,https://localhost:3002,http://localhost:3003,http://localhost:3004
ADMIN_APP_URL=http://localhost:3000
CUSTOMER_APP_URL=https://localhost:3002
MITRA_APP_URL=http://localhost:3004

# WAJIB HTTPS untuk Xendit Components (backend & browser).
XENDIT_COMPONENTS_ORIGINS=https://localhost:3002

# --- Landing page (di-inline saat docker build) ----------------------------
NEXT_PUBLIC_CUSTOMER_APP_URL=https://localhost:3002
NEXT_PUBLIC_PARTNER_APP_URL=http://localhost:3004
